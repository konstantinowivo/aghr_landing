# ============================================
# Email Backend (Nodemailer + Gmail)
# ============================================
# IMPORTANTE: Estas variables DEBEN configurarse en Vercel Dashboard
# Dashboard > Settings > Environment Variables

# Tu cuenta de Gmail
EMAIL_USER=tu-email@gmail.com

# App Password de Gmail (NO uses tu contraseña normal)
# Cómo obtenerlo: https://support.google.com/accounts/answer/185833
# 1. Habilita verificación en 2 pasos en tu cuenta Google
# 2. Ve a https://myaccount.google.com/apppasswords
# 3. Selecciona "Correo" y "Otro (nombre personalizado)"
# 4. Genera la contraseña (16 caracteres sin espacios)
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Email donde recibirás los formularios (puede ser el mismo que EMAIL_USER)
EMAIL_TO=hola@aghr-consulting.com

# ============================================
# EmailJS (LEGACY - ya no se usa)
# ============================================
# Dejamos estas variables por si necesitas volver a EmailJS
# VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
# VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
# VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# ============================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ============================================
#
# 1. DESARROLLO LOCAL:
#    - Copia este archivo como .env
#    - Completa las variables EMAIL_USER, EMAIL_PASS, EMAIL_TO
#    - NO subas .env a Git (ya está en .gitignore)
#
# 2. PRODUCCIÓN (VERCEL):
#    - Ve a tu proyecto en Vercel Dashboard
#    - Settings > Environment Variables
#    - Agrega EMAIL_USER, EMAIL_PASS, EMAIL_TO
#    - Marca como "Production" y "Preview"
#    - Deploy nuevamente para aplicar los cambios
#
